{
  "expo": {
    "name": "JobRadar",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/jobradar-app-icon.png",
    "scheme": ["jobradar", "mobile"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/jobradar-app-icon.png",
      "bundleIdentifier": "com.ulucakcemaldeniz.jobradar",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "JobRadar",
        "CFBundleName": "JobRadar",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8B2CFC",
        "foregroundImage": "./assets/jobradar-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ulucakcemaldeniz.jobradar"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/jobradar-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F6FB",
          "dark": {
            "backgroundColor": "#0B1220",
            "image": "./assets/jobradar-app-icon.png"
          },
          "image": "./assets/jobradar-app-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f78701a3-a59b-4e5d-a4a2-398081a32728"
      }
    },
    "owner": "ulucakcemaldeniz"
  }
}
