SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
# Production: true. Cron is in-process; the API must stay awake.
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_INTERVAL_HOURS=1
SCHEDULER_ENABLED=
SCHEDULER_TIMEZONE=Europe/Istanbul
JOB_NEW_WINDOW_HOURS=24
JOB_SOURCE_MAX_AGE_DAYS=30
JOB_INACTIVE_AFTER_DAYS=7
ENABLE_DEV_ENDPOINTS=false
LINKEDIN_PROVIDER=disabled
LINKEDIN_BASE_URL=https://www.linkedin.com
LINKEDIN_REQUEST_TIMEOUT_MS=10000
LINKEDIN_REQUEST_DELAY_MS=1000
LINKEDIN_MAX_PAGES=3
KARIYER_NET_PROVIDER=mock
KARIYER_NET_BASE_URL=https://www.kariyer.net
KARIYER_NET_REQUEST_TIMEOUT_MS=10000
KARIYER_NET_REQUEST_DELAY_MS=750
KARIYER_NET_MAX_PAGES=10
KARIYER_NET_DEBUG_HTML=false
# Optional. Expo Push works without this; set it to authenticate as your Expo account.
EXPO_ACCESS_TOKEN=
# Optional location catalog overrides. Defaults: REST Countries + CountryStateCity states.
# LOCATION_STATES_URL may include {code}, e.g. .../states/{code}.json
LOCATION_COUNTRIES_URL=
LOCATION_STATES_URL=
