SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
# Production: true. Cron is in-process; the API must stay awake.
DISCOVERY_SCHEDULER_ENABLED=false
DISCOVERY_INTERVAL_HOURS=1
SCHEDULER_ENABLED=
SCHEDULER_TIMEZONE=Europe/Istanbul
JOB_NEW_WINDOW_HOURS=24
JOB_SOURCE_MAX_AGE_DAYS=30
JOB_INACTIVE_AFTER_DAYS=7
ENABLE_DEV_ENDPOINTS=false
LINKEDIN_PROVIDER=disabled
LINKEDIN_BASE_URL=https://www.linkedin.com
LINKEDIN_REQUEST_TIMEOUT_MS=10000
LINKEDIN_REQUEST_DELAY_MS=1000
LINKEDIN_MAX_PAGES=3
KARIYER_NET_PROVIDER=mock
KARIYER_NET_BASE_URL=https://www.kariyer.net
KARIYER_NET_REQUEST_TIMEOUT_MS=10000
KARIYER_NET_REQUEST_DELAY_MS=750
KARIYER_NET_MAX_PAGES=10
KARIYER_NET_MAX_DETAIL_REQUESTS=8
KARIYER_NET_DEBUG_HTML=false
DISCOVERY_MAX_QUERIES_PER_SEARCH_SOURCE=8
DISCOVERY_KARIYER_NET_MAX_QUERIES_PER_HOUR=4
DISCOVERY_TIME_BUDGET_MS_PER_SEARCH_SOURCE=40000
# Optional. Expo Push works without this; set it to authenticate as your Expo account.
EXPO_ACCESS_TOKEN=
# Optional. Backend-only REST Countries v5 key. Leave empty to skip the
# third-party call and use the built-in ISO country catalog.
# Never expose this to mobile or web clients.
REST_COUNTRIES_API_KEY=
# Optional URL override. Deprecated v3.1 URLs are ignored.
LOCATION_COUNTRIES_URL=
# Optional. Not used for TR; Turkey uses the built-in 81-province catalog.
# LOCATION_STATES_URL may include {code}, e.g. .../states/{code}.json
LOCATION_STATES_URL=
# Optional. Empty = Telegram alerts stay off; the API still starts.
TELEGRAM_BOT_TOKEN=
# Public bot username without @. Shown in the app so the user can open the bot.
TELEGRAM_BOT_USERNAME=
# Required for POST /v1/telegram/webhook. Never log this value.
TELEGRAM_WEBHOOK_SECRET=
# Used only by `npm run telegram:set-webhook`. Not read at API startup.
TELEGRAM_WEBHOOK_URL=
# Temporary single-user fallback. Only this JobRadar user receives
# TELEGRAM_CHAT_ID messages, and only if they have no linked chat yet.
# Leave empty to disable the fallback (preferred).
TELEGRAM_LEGACY_USER_ID=
TELEGRAM_CHAT_ID=
